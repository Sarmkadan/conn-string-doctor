    [Fact]
    public void ConversionResult_WithNullParameters_HandlesGracefully()
    {
        // Act
        var result = new ConnectionStringConverter.ConversionResult(null, null, null);

        // Assert
        Assert.Equal(string.Empty, result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

    [Fact]
    public void ConversionResult_PropertiesAreReadable()
    {
        // Arrange
        var connectionString = "Server=localhost";
        var unmapped = new[] { "UnknownKey" };
        var warnings = new[] { "Warning message" };

        // Act
        var result = new ConnectionStringConverter.ConversionResult(connectionString, unmapped, warnings);

        // Assert
        Assert.Equal("Server=localhost", result.ConnectionString);
        Assert.Single(result.UnmappedKeys);
        Assert.Equal("UnknownKey", result.UnmappedKeys[0]);
        Assert.Single(result.Warnings);
        Assert.Equal("Warning message", result.Warnings[0]);
    }

    [Fact]
    public void Parse_WithComplexConnectionString_ParsesAllParts()
    {
        // Arrange
        var connectionString = "Server=my server,192.168.1.1;Database=test-db;User ID=my user;Password=pass@word#123;Port=1433;Encrypt=True;Trust Server Certificate=False";

        // Act
        var result = ConnectionStringConverter.Parse(connectionString);

        // Assert
        Assert.Equal(7, result.OriginalParts.Count);
        Assert.Equal("my server,192.168.1.1", result.OriginalParts["Server"]);
        Assert.Equal("test-db", result.OriginalParts["Database"]);
        Assert.Equal("my user", result.OriginalParts["User ID"]);
        Assert.Equal("pass@word#123", result.OriginalParts["Password"]);
        Assert.Equal("1433", result.OriginalParts["Port"]);
        Assert.Equal("True", result.OriginalParts["Encrypt"]);
        Assert.Equal("False", result.OriginalParts["Trust Server Certificate"]);
    }

    [Fact]
    public void Convert_SemanticRoundTrip_SqlServerToPostgresAndBack()
    {
        // Arrange - Original SQL Server connection string
        var original = "Server=localhost,192.168.1.1;Database=MyAppDB;User ID=appuser;Password=P@ssw0rd!;Port=1433;Encrypt=True";

        // Act - Convert to PostgreSQL
        var info1 = ConnectionStringConverter.Parse(original);
        info1.Provider = "sqlserver";
        var postgres = ConnectionStringConverter.Convert(info1, "postgres");

        // Assert - PostgreSQL conversion
        Assert.Equal("Host=localhost,192.168.1.1;Database=MyAppDB;Username=appuser;Password=P@ssw0rd!;Port=1433;SSL Mode=True", postgres.ConnectionString);
        Assert.Empty(postgres.UnmappedKeys);
        Assert.Empty(postgres.Warnings);

        // Act - Convert back to SQL Server
        var info2 = ConnectionStringConverter.Parse(postgres.ConnectionString);
        info2.Provider = "postgres";
        var sqlserver = ConnectionStringConverter.Convert(info2, "sqlserver");

        // Assert - Round-trip conversion
        Assert.Equal("Server=localhost,192.168.1.1;Database=MyAppDB;User ID=appuser;Password=P@ssw0rd!;Port=1433;Encrypt=True", sqlserver.ConnectionString);
        Assert.Empty(sqlserver.UnmappedKeys);
        Assert.Empty(sqlserver.Warnings);
    }

    [Fact]
    public void Convert_SemanticRoundTrip_SqlServerToMySqlAndBack()
    {
        // Arrange - Original SQL Server connection string
        var original = "Server=db.example.com;Database=ProductionDB;User ID=admin;Password=Secret123;Port=3306";

        // Act - Convert to MySQL
        var info1 = ConnectionStringConverter.Parse(original);
        info1.Provider = "sqlserver";
        var mysql = ConnectionStringConverter.Convert(info1, "mysql");

        // Assert - MySQL conversion
        Assert.Equal("Server=db.example.com;Database=ProductionDB;Uid=admin;Password=Secret123;Port=3306", mysql.ConnectionString);
        Assert.Empty(mysql.UnmappedKeys);
        Assert.Empty(mysql.Warnings);

        // Act - Convert back to SQL Server
        var info2 = ConnectionStringConverter.Parse(mysql.ConnectionString);
        info2.Provider = "mysql";
        var sqlserver = ConnectionStringConverter.Convert(info2, "sqlserver");

        // Assert - Round-trip conversion
        Assert.Equal("Server=db.example.com;Database=ProductionDB;User ID=admin;Password=Secret123;Port=3306", sqlserver.ConnectionString);
        Assert.Empty(sqlserver.UnmappedKeys);
        Assert.Empty(sqlserver.Warnings);
    }

    [Fact]
    public void Convert_EmptyProvider_UsesGenericProvider()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = string.Empty;

        // Act - Convert from generic to PostgreSQL
        var result = ConnectionStringConverter.Convert(info, "postgres");

        // Assert - Should still work with generic provider
        Assert.Equal("Host=localhost;Database=testdb", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
    }

    [Fact]
    public void Convert_WhitespaceProvider_TrimsAndUsesGenericProvider()
