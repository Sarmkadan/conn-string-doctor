using Xunit;

namespace ConnStringDoctor.Tests;

public class ConnectionStringConverterTests
{
    [Fact]
    public void Parse_WithNullConnectionString_ReturnsEmptyInfo()
    {
        // Act
        var result = ConnectionStringConverter.Parse(null);

        // Assert
        Assert.Equal(string.Empty, result.Provider);
        Assert.Empty(result.OriginalParts);
    }

    [Fact]
    public void Parse_WithEmptyConnectionString_ReturnsEmptyInfo()
    {
        // Act
        var result = ConnectionStringConverter.Parse(string.Empty);

        // Assert
        Assert.Equal(string.Empty, result.Provider);
        Assert.Empty(result.OriginalParts);
    }

    [Fact]
    public void Parse_WithWhitespaceConnectionString_ReturnsEmptyInfo()
    {
        // Act
        var result = ConnectionStringConverter.Parse("   ");

        // Assert
        Assert.Equal(string.Empty, result.Provider);
        Assert.Empty(result.OriginalParts);
    }

    [Fact]
    public void Parse_WithSimpleConnectionString_ParsesKeyValuePairs()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb;User ID=admin;Password=secret";

        // Act
        var result = ConnectionStringConverter.Parse(connectionString);

        // Assert
        Assert.Equal(string.Empty, result.Provider);
        Assert.Equal(4, result.OriginalParts.Count);
        Assert.Equal("localhost", result.OriginalParts["Server"]);
        Assert.Equal("testdb", result.OriginalParts["Database"]);
        Assert.Equal("admin", result.OriginalParts["User ID"]);
        Assert.Equal("secret", result.OriginalParts["Password"]);
    }

    [Fact]
    public void Parse_WithQuotedValues_ParsesCorrectly()
    {
        // Arrange
        var connectionString = "Server=my server;Database=my-db;User ID=my user;Password=my password";

        // Act
        var result = ConnectionStringConverter.Parse(connectionString);

        // Assert
        Assert.Equal(4, result.OriginalParts.Count);
        Assert.Equal("my server", result.OriginalParts["Server"]);
        Assert.Equal("my-db", result.OriginalParts["Database"]);
        Assert.Equal("my user", result.OriginalParts["User ID"]);
        Assert.Equal("my password", result.OriginalParts["Password"]);
    }

    [Fact]
    public void Parse_WithDuplicateKeys_LastValueWins()
    {
        // Arrange
        var connectionString = "Server=server1;Server=server2;Database=testdb";

        // Act
        var result = ConnectionStringConverter.Parse(connectionString);

        // Assert
        Assert.Equal(2, result.OriginalParts.Count);
        Assert.Equal("server2", result.OriginalParts["Server"]);
        Assert.Equal("testdb", result.OriginalParts["Database"]);
    }

    [Fact]
    public void TryParse_WithValidConnectionString_ReturnsTrueAndInfo()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb";

        // Act
        var success = ConnectionStringConverter.TryParse(connectionString, out var result);

        // Assert
        Assert.True(success);
        Assert.NotNull(result);
        Assert.Equal(2, result!.OriginalParts.Count);
    }

    [Fact]
    public void TryParse_WithInvalidConnectionString_ReturnsFalseAndNull()
    {
        // Arrange - This should throw an exception that TryParse catches
        var connectionString = "This is not a valid connection string";

        // Act
        var success = ConnectionStringConverter.TryParse(connectionString, out var result);

        // Assert
        Assert.False(success);
        Assert.Null(result);
    }

    [Fact]
    public void Convert_SameProvider_PassesThroughAllKeys()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb;User ID=admin;Password=secret";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlserver";

        // Act
        var result = ConnectionStringConverter.Convert(info, "sqlserver");

        // Assert
        Assert.Equal("Server=localhost;Database=testdb;User ID=admin;Password=secret", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

    [Fact]
    public void Convert_SameProviderDifferentCase_PassesThroughAllKeys()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "POSTGRES";

        // Act
        var result = ConnectionStringConverter.Convert(info, "Postgres");

        // Assert
        Assert.Equal("Server=localhost;Database=testdb", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

    [Fact]
    public void Convert_SqlServerToPostgres_MapsKeysCorrectly()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb;User ID=admin;Password=secret;Port=5432";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlserver";

        // Act
        var result = ConnectionStringConverter.Convert(info, "postgres");

        // Assert
        Assert.Equal("Host=localhost;Database=testdb;Username=admin;Password=secret;Port=5432", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

