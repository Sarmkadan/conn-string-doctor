    [Fact]
    public void Convert_SqliteToGeneric_PassesThrough()
    {
        // Arrange
        var connectionString = "Data Source=/path/to/db;Mode=ReadWrite";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlite";

        // Act
        var result = ConnectionStringConverter.Convert(info, "generic");

        // Assert
        Assert.Equal("Data Source=/path/to/db;Mode=ReadWrite", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

    [Fact]
    public void Convert_GenericToSqlite_PassesThrough()
    {
        // Arrange
        var connectionString = "Data Source=/path/to/db;Mode=ReadWrite";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "generic";

        // Act
        var result = ConnectionStringConverter.Convert(info, "sqlite");

        // Assert
        Assert.Equal("Data Source=/path/to/db;Mode=ReadWrite", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

    [Fact]
    public void Convert_WithUnmappedKeys_ReportsUnmappedAndWarning()
    {
        // Arrange - SQL Server connection string with SQLite-specific key
        var connectionString = "Server=localhost;Database=testdb;Data Source=/path/to/db";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlserver";

        // Act
        var result = ConnectionStringConverter.Convert(info, "postgres");

        // Assert
        Assert.Equal("Host=localhost;Database=testdb", result.ConnectionString);
        Assert.Single(result.UnmappedKeys);
        Assert.Contains("Data Source", result.UnmappedKeys);
        Assert.Single(result.Warnings);
        Assert.Contains("Data Source", result.Warnings[0]);
    }

    [Fact]
    public void Convert_WithMultipleUnmappedKeys_ReportsAll()
    {
        // Arrange
        var connectionString = "Server=localhost;Database=testdb;UnknownKey1=value1;UnknownKey2=value2";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlserver";

        // Act
        var result = ConnectionStringConverter.Convert(info, "postgres");

        // Assert
        Assert.Equal("Host=localhost;Database=testdb", result.ConnectionString);
        Assert.Equal(2, result.UnmappedKeys.Count);
        Assert.Contains("UnknownKey1", result.UnmappedKeys);
        Assert.Contains("UnknownKey2", result.UnmappedKeys);
        Assert.Equal(2, result.Warnings.Count);
    }

    [Fact]
    public void Convert_WithCommonKeywords_UsesFallbackMappings()
    {
        // Arrange - SQL Server connection string using common keywords
        var connectionString = "Data Source=localhost;Initial Catalog=testdb;User=admin;Pwd=secret";
        var info = ConnectionStringConverter.Parse(connectionString);
        info.Provider = "sqlserver";

        // Act
        var result = ConnectionStringConverter.Convert(info, "postgres");

        // Assert
        Assert.Equal("Host=localhost;Database=testdb;Username=admin;Password=secret", result.ConnectionString);
        Assert.Empty(result.UnmappedKeys);
        Assert.Empty(result.Warnings);
    }

